# Backend Application Settings
PROJECT_NAME="PsychePredict AI - Psychological Disorder Prediction API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# CORS Configuration (comma-separated origins)
