# Database Configuration (SQLite)
DATABASE_URL="sqlite:///./assessments.db"

# Future Deep Learning Model Settings (Module 3 placeholder)
MODEL_MODULE_READY=false
MODEL_CHECKPOINT_PATH="./models/deep_multiclass_weights.pt"
